#!/usr/bin/env python3
"""Repo-local entry point for the lab CLI.

The first version is intentionally not installed into PATH. Run this
script from the repository: ``./bin/lab ...``.
"""

from __future__ import annotations

import os
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(REPO_ROOT, "src"))

from labctl.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
